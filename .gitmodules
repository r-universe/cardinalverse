[submodule ".registry"]
	path = .registry
	url = https://github.com/cardinalverse/cardinalverse.r-universe.dev
	branch = HEAD
[submodule "Cardinal"]
	path = Cardinal
	url = https://github.com/Cardinalverse/Cardinal
[submodule "CardinalIO"]
	path = CardinalIO
	url = https://github.com/Cardinalverse/CardinalIO
[submodule "CardinalWorkflows"]
	path = CardinalWorkflows
	url = https://github.com/Cardinalverse/CardinalWorkflows
